# Copy separately for each worker process. Use unique worker IDs and tokens.
FOUNDRY_REMOTE_WORKER_TOKEN=
FOUNDRY_WORKER_ID=vector-buffer-worker-1
FOUNDRY_WORKER_IMAGE_DIGEST=sha256:REPLACE_WITH_IMMUTABLE_IMAGE_ID
FOUNDRY_WORKER_CAPABILITY_ID=vector.buffer
FOUNDRY_WORKER_CAPABILITY_VERSION=1.0.0
FOUNDRY_IMPLEMENTATION_ID=vector-buffer-shapely

# Process-level execution and resource ceilings.
FOUNDRY_MAX_CONCURRENT_EXECUTIONS=2
FOUNDRY_EXECUTION_TIMEOUT_SECONDS=110
FOUNDRY_MAX_INPUT_BYTES=67108864
FOUNDRY_MAX_REQUEST_BYTES=68157440
FOUNDRY_MAX_OUTPUT_BYTES=134217728
