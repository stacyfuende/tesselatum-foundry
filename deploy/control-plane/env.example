# Copy outside the repository and populate with unique secret values.
FOUNDRY_API_TOKEN=
FOUNDRY_API_MAX_REQUEST_BYTES=33554432
FOUNDRY_API_MAX_RESPONSE_BYTES=134217728
FOUNDRY_REMOTE_WORKER_TIMEOUT_SECONDS=120
FOUNDRY_REMOTE_WORKER_MAX_INPUT_BYTES=134217728
FOUNDRY_REMOTE_WORKER_MAX_OUTPUT_BYTES=134217728
FOUNDRY_DATA_DIR=/var/lib/foundry
FOUNDRY_WORKER_MODE=remote

# HTTPS base URLs of the separately deployed capability workers.
FOUNDRY_VECTOR_BUFFER_URL=https://buffer-worker.internal
FOUNDRY_VECTOR_BUFFER_TOKEN=
FOUNDRY_VECTOR_REPROJECT_URL=https://reproject-worker.internal
FOUNDRY_VECTOR_REPROJECT_TOKEN=
