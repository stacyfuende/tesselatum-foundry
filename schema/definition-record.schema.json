{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessellatum-foundry:schema:definition-record:1.0.0",
  "title": "Versioned Definition Record",
  "description": "Immutable registry record for one exact Geo-Cell or Recipe definition version.",
  "type": "object",
  "required": [
    "kind",
    "definition_ref",
    "created_at",
    "created_by",
    "checksum",
    "definition"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "cell",
        "recipe"
      ]
    },
    "definition_ref": {
      "type": "object",
      "required": [
        "definition_id",
        "version"
      ],
      "properties": {
        "definition_id": {
          "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
        },
        "version": {
          "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
    },
    "checksum": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cell"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "definition": {
            "required": [
              "cell_id",
              "version"
            ],
            "properties": {
              "cell_id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          },
          "definition_ref": {
            "properties": {
              "definition_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recipe"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "definition": {
            "required": [
              "recipe_id",
              "version"
            ],
            "properties": {
              "recipe_id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
