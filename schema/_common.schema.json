{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tessellatum Foundry shared schema definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "required": [
        "artifact_id",
        "version"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "capabilityRef": {
      "type": "object",
      "required": [
        "capability_id",
        "version"
      ],
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "additionalProperties": false
    },
    "cellRef": {
      "type": "object",
      "required": [
        "cell_id",
        "version"
      ],
      "properties": {
        "cell_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "crs": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": [
            "string",
            "integer"
          ]
        },
        "wkt2": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "authority",
            "code"
          ]
        },
        {
          "required": [
            "wkt2"
          ]
        }
      ],
      "additionalProperties": false
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 6,
      "description": "GIS x/y order: [min_x, min_y, max_x, max_y], optionally [min_x, min_y, min_z, max_x, max_y, max_z]."
    },
    "findingStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "warning",
        "not_assessed",
        "requires_review"
      ]
    }
  },
  "$id": "urn:tessellatum-foundry:schema:common:1.0.0"
}
