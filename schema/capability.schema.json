{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Capability Contract",
  "description": "Versioned, engine-independent semantic contract for a spatial operation.",
  "type": "object",
  "required": [
    "capability_id",
    "version",
    "name",
    "description",
    "category",
    "input_ports",
    "parameter_schema",
    "output_ports",
    "determinism"
  ],
  "properties": {
    "capability_id": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
    },
    "version": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/semver"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "input_ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "port_id",
          "data_kind",
          "required"
        ],
        "properties": {
          "port_id": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
          },
          "description": {
            "type": "string"
          },
          "data_kind": {
            "type": "string",
            "enum": [
              "vector",
              "raster",
              "table",
              "point_cloud",
              "mesh",
              "file",
              "any"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "accepted_media_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "spatial": {
            "type": "object",
            "properties": {
              "crs_required": {
                "type": "boolean"
              },
              "crs_type": {
                "type": "string",
                "enum": [
                  "geographic",
                  "projected",
                  "geocentric",
                  "engineering",
                  "compound",
                  "any"
                ]
              },
              "geometry_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "same_crs_as": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "parameter_schema": {
      "type": "object",
      "description": "Embedded JSON Schema defining normalized capability parameters.",
      "properties": {
        "type": {
          "type": "string"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "type": [
            "boolean",
            "object"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "output_ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "port_id",
          "data_kind"
        ],
        "properties": {
          "port_id": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
          },
          "description": {
            "type": "string"
          },
          "data_kind": {
            "type": "string",
            "enum": [
              "vector",
              "raster",
              "table",
              "point_cloud",
              "mesh",
              "file",
              "any"
            ]
          },
          "media_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "spatial": {
            "type": "object",
            "properties": {
              "crs_required": {
                "type": "boolean"
              },
              "crs_type": {
                "type": "string",
                "enum": [
                  "geographic",
                  "projected",
                  "geocentric",
                  "engineering",
                  "compound",
                  "any"
                ]
              },
              "geometry_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "same_crs_as": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "determinism": {
      "type": "string",
      "enum": [
        "deterministic",
        "conditionally_deterministic",
        "nondeterministic"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cache_policy": {
      "type": "string",
      "enum": [
        "allowed",
        "conditional",
        "disabled"
      ],
      "default": "allowed"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$id": "urn:tessellatum-foundry:schema:capability:1.0.0"
}
