{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessellatum-foundry:schema:experiment:1.0.0",
  "title": "Foundry Experiment",
  "description": "Declarative, reproducible comparison of spatial methods and parameter choices.",
  "type": "object",
  "required": ["experiment_id", "version", "title", "objective", "cell_template", "baseline_parameters"],
  "properties": {
    "experiment_id": {"$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"},
    "version": {"$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/version"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "cell_template": {"$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/cellRef"},
    "baseline_parameters": {"type": "object"},
    "parameter_axes": {
      "type": "object",
      "description": "Named parameter dimensions expanded as a Cartesian product.",
      "additionalProperties": {"type": "array", "minItems": 1, "items": {}}
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method_id", "label"],
        "properties": {
          "method_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "capability": {"$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/capabilityRef"},
          "parameter_overrides": {"type": "object"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "reference"],
              "properties": {
                "type": {"enum": ["paper", "documentation", "benchmark", "user_note"]},
                "reference": {"type": "string", "minLength": 1},
                "title": {"type": "string"},
                "claim": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "max_variants": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}