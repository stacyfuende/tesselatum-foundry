{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Geo-Cell Declaration",
  "description": "Immutable declarative instance of a capability computation; contains no execution state or implementation code.",
  "type": "object",
  "required": [
    "cell_id",
    "version",
    "capability",
    "inputs",
    "parameters",
    "output_contracts"
  ],
  "properties": {
    "cell_id": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
    },
    "version": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/version"
    },
    "capability": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/capabilityRef"
    },
    "inputs": {
      "type": "object",
      "description": "Port bindings. Bindings may reference immutable artifacts or an upstream cell output.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "source",
              "artifact"
            ],
            "properties": {
              "source": {
                "const": "artifact"
              },
              "artifact": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/artifactRef"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "source",
              "cell_id",
              "cell_version",
              "output_port"
            ],
            "properties": {
              "source": {
                "const": "cell_output"
              },
              "cell_id": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
              },
              "cell_version": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/version"
              },
              "output_port": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "output_contracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "data_kind"
        ],
        "properties": {
          "data_kind": {
            "type": "string",
            "enum": [
              "vector",
              "raster",
              "table",
              "point_cloud",
              "mesh",
              "file",
              "any"
            ]
          },
          "media_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "crs": {
            "oneOf": [
              {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/crs"
              },
              {
                "type": "null"
              }
            ]
          },
          "geometry_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "validation_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "measurement_crs": {
          "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/crs"
        },
        "linear_unit": {
          "type": "string"
        },
        "area_unit": {
          "type": "string"
        },
        "required_geometry_validity": {
          "type": "boolean"
        },
        "spatial_relationships": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$id": "urn:tessellatum-foundry:schema:cell:1.0.0"
}
