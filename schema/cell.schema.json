{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Geo-Cell Declaration",
  "description": "Immutable declarative instance of a capability computation; contains no execution state or implementation code.",
  "type": "object",
  "required": [
    "cell_id",
    "version",
    "capability",
    "inputs",
    "parameters",
    "output_contracts"
  ],
  "properties": {
    "cell_id": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
    },
    "version": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/version"
    },
    "capability": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/capabilityRef"
    },
    "inputs": {
      "type": "object",
      "description": "Port bindings may reference immutable Artifacts, upstream cell outputs, or externally held data resources.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "source",
              "artifact"
            ],
            "properties": {
              "source": {
                "const": "artifact"
              },
              "artifact": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/artifactRef"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "source",
              "cell_id",
              "cell_version",
              "output_port"
            ],
            "properties": {
              "source": {
                "const": "cell_output"
              },
              "cell_id": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
              },
              "cell_version": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/version"
              },
              "output_port": {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "source",
              "reference",
              "spatial"
            ],
            "properties": {
              "source": {
                "const": "external"
              },
              "reference": {
                "$ref": "urn:tessellatum-foundry:schema:external-data-reference:1.0.0"
              },
              "spatial": {
                "type": "object",
                "required": [
                  "kind",
                  "crs"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "vector",
                      "raster"
                    ]
                  },
                  "crs": {
                    "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/crs"
                  },
                  "geometry_types": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "raster": {
                    "type": "object",
                    "required": [
                      "width",
                      "height",
                      "band_count"
                    ],
                    "properties": {
                      "width": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "band_count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "dtypes": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      },
                      "resolution": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "vector"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "geometry_types"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "raster"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "raster"
                      ]
                    }
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "output_contracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "data_kind"
        ],
        "properties": {
          "data_kind": {
            "type": "string",
            "enum": [
              "vector",
              "raster",
              "table",
              "point_cloud",
              "mesh",
              "file",
              "any"
            ]
          },
          "media_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "crs": {
            "oneOf": [
              {
                "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/crs"
              },
              {
                "type": "null"
              }
            ]
          },
          "geometry_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "validation_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "measurement_crs": {
          "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/crs"
        },
        "linear_unit": {
          "type": "string"
        },
        "area_unit": {
          "type": "string"
        },
        "buffer_arc_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Maximum permitted radial sagitta for vector.buffer, expressed in the declared linear_unit."
        },
        "required_geometry_validity": {
          "type": "boolean"
        },
        "spatial_relationships": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$id": "urn:tessellatum-foundry:schema:cell:1.0.0"
}
