{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Run",
  "description": "One immutable execution attempt for exact Geo-Cell and Capability versions.",
  "type": "object",
  "required": [
    "run_id",
    "attempt",
    "cell",
    "capability",
    "status",
    "created_at",
    "input_snapshots",
    "normalized_parameters",
    "events"
  ],
  "properties": {
    "run_id": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "cell": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/cellRef"
    },
    "recipe": {
      "type": "object",
      "required": [
        "recipe_id",
        "version"
      ],
      "properties": {
        "recipe_id": {
          "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
        },
        "version": {
          "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "waiting_for_resources",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "created_at": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/timestamp"
    },
    "started_at": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/timestamp"
    },
    "retry_of_run_id": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
    },
    "worker": {
      "type": "object",
      "required": [
        "worker_id",
        "worker_type"
      ],
      "properties": {
        "worker_id": {
          "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
        },
        "worker_type": {
          "type": "string",
          "enum": [
            "local_docker",
            "remote"
          ]
        },
        "region": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "required": [
        "implementation_id",
        "version"
      ],
      "properties": {
        "implementation_id": {
          "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
        },
        "version": {
          "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "input_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_port",
          "artifact",
          "checksum"
        ],
        "properties": {
          "input_port": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
          },
          "artifact": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/artifactRef"
          },
          "checksum": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/sha256"
          },
          "source_run_id": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
          },
          "source_output_port": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "source_run_id"
              ]
            },
            "then": {
              "required": [
                "source_output_port"
              ]
            }
          },
          {
            "if": {
              "required": [
                "source_output_port"
              ]
            },
            "then": {
              "required": [
                "source_run_id"
              ]
            }
          }
        ]
      }
    },
    "normalized_parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "runtime_image_digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "resource_usage": {
      "type": "object",
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "scratch_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "output_port",
          "artifact"
        ],
        "properties": {
          "output_port": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
          },
          "artifact": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/artifactRef"
          }
        },
        "additionalProperties": false
      }
    },
    "validation_report_ids": {
      "type": "array",
      "items": {
        "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "event_type"
        ],
        "properties": {
          "timestamp": {
            "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/timestamp"
          },
          "event_type": {
            "type": "string"
          },
          "detail": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "capability": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/capabilityRef"
    },
    "recipe_execution_id": {
      "$ref": "urn:tessellatum-foundry:schema:common:1.0.0#/$defs/identifier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "timed_out"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "finished_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "started_at",
          "worker",
          "implementation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "started_at",
          "worker",
          "implementation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "outputs",
          "validation_report_ids"
        ]
      }
    },
    {
      "if": {
        "required": [
          "recipe_execution_id"
        ]
      },
      "then": {
        "required": [
          "recipe"
        ]
      }
    },
    {
      "if": {
        "required": [
          "recipe"
        ]
      },
      "then": {
        "required": [
          "recipe_execution_id"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$id": "urn:tessellatum-foundry:schema:run:1.0.0"
}
